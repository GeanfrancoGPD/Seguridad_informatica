dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword
  by dn.exact="cn=admin,dc=envios,dc=local" manage
  by self auth
  by anonymous auth
  by * none
olcAccess: {1}to dn.base=""
  by * read
olcAccess: {2}to dn.base="dc=envios,dc=local"
  by * read
olcAccess: {3}to dn.subtree="dc=envios,dc=local"
  by dn.exact="cn=admin,dc=envios,dc=local" manage
  by group.exact="cn=Administradores,ou=roles,dc=envios,dc=local" read
  by self read
  by * none
olcAccess: {4}to attrs=shadowLastChange
  by self write
  by * read
